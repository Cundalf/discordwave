# ── Discord ────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ── Radio SUB/WAVE ─────────────────────────────────────────
# Base de la estación, sin barra final
SUBWAVE_BASE_URL=https://radio.cundalf.com.ar
# Password de oyente (Settings → Privacy). Irá como HTTP Basic en el stream
# y como x-station-auth en los reads gated.
SUBWAVE_STREAM_PASSWORD=GlobexAspen
# Montaje del stream (por defecto MP3)
SUBWAVE_STREAM_MOUNT=/stream.mp3

# ── Comportamiento ─────────────────────────----------------
# Salir del canal si no queda nadie escuchando (minutos). 0 = desactivado
AUTO_LEAVE_MINUTES=10
# Volumen por defecto (0-100)
DEFAULT_VOLUME=80
# Poll principal y de presence en milisegundos
NP_POLL_MS=30000
# Intentos totales de apertura del stream antes de rendirse (backoff 250ms-2s; 401/403/404 no reintentan)
STREAM_RETRIES=6

# ── Opcional ─────────────────────────────────--------------
# GUILD_ID para deploy rápido de comandos en un solo server (vacío = global)
GUILD_ID=
# ── Rate limits (seguridad, por guild) ───────────────────────
# Cooldown del /sintonizar por guild (anti-flapping de streams); 0 = off
RATE_LIMIT_TUNE_COOLDOWN_S=20
# Máximo de hits cada 10s por guild para /suena y /estado; 0 = off
RATE_LIMIT_API_MAX_PER_10S=5

# ── Pedidos a la cabina (alineado con Settings → Requests de tu radio) ──
# Radio: Max Queued 12 · Seconds between 60s · Per-listener cap 8/h · Station cap 30/h
# ¡Ojo!: el bot es UNA IP para la radio → sus pedidos comparten el per-listener.
# Cooldown por usuario de Discord (s)
REQUEST_COOLDOWN_S=60
# Espaciado global entre pedidos del bot (s) = "Seconds between requests" de la radio
REQUEST_GLOBAL_SPACING_S=60
# Tope global/hora de pedidos del bot = "Per-listener hourly cap" de la radio; 0 = off
REQUEST_HOURLY_CAP=8
